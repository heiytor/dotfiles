#!/usr/bin/env sh

set -e

if [ "$1" != "br" ] && [ "$1" != "us" ]; then
   echo "Error: Use 'br' or 'us'" >&2
   exit 1
fi

# Saved first: ~/.config/hypr/env.lua reads it, so the layout survives config reloads
echo "$1" > "$HOME/.de-config/session/keyboard_layout"
hyprctl eval "hl.config({ input = { kb_layout = \"$1\" } })" > /dev/null
