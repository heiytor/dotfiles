#!/usr/bin/env sh
set -e

APP_NAME="$1"

if [ -z "$APP_NAME" ]; then
    echo "Usage: de-webapp-remove \"Name\""
    exit 1
fi

APPS_DIR="$HOME/.de-config/applications/webapps"
ICONS_DIR="$APPS_DIR/icons"

NORMALIZED_NAME=$(echo "$APP_NAME" | tr '[:upper:]' '[:lower:]' | tr ' ' '-')
DESKTOP_FILE="$APPS_DIR/${NORMALIZED_NAME}.desktop"

if [ ! -f "$DESKTOP_FILE" ]; then
    echo "✗ Web app '$APP_NAME' not found"
    exit 1
fi

ICON=$(grep "^Icon=" "$DESKTOP_FILE" | cut -d= -f2)

rm -f "$DESKTOP_FILE"
echo "✓ Removed: $DESKTOP_FILE"

if [ -f "$ICON" ] && echo "$ICON" | grep -q "^$ICONS_DIR"; then
    rm -f "$ICON"
    echo "✓ Removed: $ICON"
fi

echo "✓ Web app '$APP_NAME' removed"
de-restart-applications-database
