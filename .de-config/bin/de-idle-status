#!/usr/bin/env sh

STATE_FILE="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/de-idle-state"

if [ ! -f "$STATE_FILE" ]; then
    if pgrep -x hypridle > /dev/null; then
        echo "󰒲"
    else
        echo "󰒳"
    fi
    exit 0
fi

case $(cat "$STATE_FILE") in
    "active")
        echo "󰒲"
        ;;
    "inactive")
        echo "󰒳"
        ;;
esac
