#!/usr/bin/env bash

# Prints the working directory of the shell in the focused terminal, so a new
# terminal can open where you already are. Falls back to $HOME.
#
#   de-cwd          uses the active Hyprland window
#   de-cwd <pid>    uses the given terminal process (handy for testing)

# The terminal's shell is a child that leads its own session on a tty. Other
# children (kitty runs kitten helpers next to the shell) are not, so they are
# skipped. With several shells (tabs), the newest one wins.
get_terminal_cwd() {
  local terminal_pid=$1 shell_pid="" children_file child stat session tty_nr

  for children_file in /proc/"$terminal_pid"/task/*/children; do
    [[ -r $children_file ]] || continue
    read -ra children <"$children_file" || true

    for child in "${children[@]}"; do
      read -r stat 2>/dev/null <"/proc/$child/stat" || continue
      read -r _ _ _ session tty_nr _ <<<"${stat##*) }"

      if (( session == child && tty_nr != 0 && child > ${shell_pid:-0} )); then
        grep -Fqsx "$(readlink -f "/proc/$child/exe")" /etc/shells && shell_pid=$child
      fi
    done
  done

  [[ -n $shell_pid ]] && readlink -f "/proc/$shell_pid/cwd" 2>/dev/null
}

main() {
  local pid=$1 class cwd=""

  if [[ -z $pid ]]; then
    read -r class pid < <(hyprctl activewindow -j | jq -r '"\(.class // "-") \(.pid // "")"')

    case "$class" in
      kitty | Alacritty | Gnome-terminal | foot | wezterm | org.wezfurlong.wezterm | com.mitchellh.ghostty) ;;
      *) pid="" ;;
    esac
  fi

  [[ -n $pid ]] && cwd=$(get_terminal_cwd "$pid")

  if [[ -d $cwd ]]; then
    echo "$cwd"
  else
    echo "$HOME"
  fi
}

main "$@"
